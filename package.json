{
  "name": "work-hub-desktop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "web:build": "node scripts/build-frontend.mjs",
    "web:watch": "vite build --watch",
    "web:check": "tsc --noEmit",
    "web:test": "npm run web:check && npm run web:build && npm run workspace:test && node --test scripts/*.test.cjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "tauri build",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:check": "node --test scripts/desktop-packaging.test.mjs",
    "desktop:test": "npm run desktop:prepare && cargo test --manifest-path src-tauri/Cargo.toml",
    "chat:build": "node scripts/build-chat.mjs",
    "chat:check": "tsc -p tsconfig.chat.json",
    "chat:test": "tsx --test scripts/chat-*.test.ts",
    "workspace:test": "tsx --test scripts/workspace-*.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "^5.0.16"
  }
}
