{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Hub",
  "version": "../package.json",
  "mainBinaryName": "work-hub",
  "identifier": "dev.work-hub.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/prepare-desktop.mjs",
      "wait": true
    },
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A task-centered workspace for cross-project development",
    "resources": { "notices/": "notices/" },
    "externalBin": ["binaries/work-hub-backend"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
